# ============================================================
# EduNova V1.0 Stable - Production Environment
# Copy menjadi .env.production sebelum menjalankan production.
# install-vps.sh dapat membuat nilai rahasia secara otomatis.
# ============================================================

COMPOSE_PROJECT_NAME=edunova
APP_NAME=EduNova
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lms.sekolah.sch.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Host port hanya dibuka ke localhost; Nginx host menjadi reverse proxy.
APP_PORT=8080

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=edunova
DB_USERNAME=edunova
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_CACHE_DB=1

# Domain tanpa http/https, pisahkan dengan koma jika lebih dari satu.
SANCTUM_STATEFUL_DOMAINS=lms.sekolah.sch.id
CORS_ALLOWED_ORIGINS=https://lms.sekolah.sch.id

# Instalasi otomatis HTTPS.
EDUNOVA_DOMAIN=lms.sekolah.sch.id
LETSENCRYPT_EMAIL=admin@sekolah.sch.id
INSTALL_SSL=true

# false untuk server sekolah. true hanya jika ingin memasang data demo.
INSTALL_DEMO_DATA=false
